# Copier ce fichier en `.env` (même dossier que manage.py) et adapter les
# valeurs pour la production. En local, laisser `.env` absent : les valeurs
# par défaut de settings.py conviennent pour du dev.

# Générer une vraie valeur secrète, ex: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-with-a-long-random-value

DJANGO_DEBUG=False

# Domaine(s) séparés par des virgules
DJANGO_ALLOWED_HOSTS=monprojet.duckdns.org

DJANGO_CORS_ALLOW_ALL=False
# Origines séparées par des virgules (avec le schéma https://)
DJANGO_CORS_ALLOWED_ORIGINS=https://monprojet.duckdns.org
