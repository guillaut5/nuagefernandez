[Unit]
Description={{ project_name }} (gunicorn)
After=network.target

[Service]
User={{ app_user }}
Group={{ app_group }}
Environment=PYTHONPATH={{ backend_dest }}
WorkingDirectory={{ backend_dest }}
ExecStart={{ venv_dir }}/bin/gunicorn  --worker-class gevent  --workers {{ gunicorn_workers }} --threads {{ gunicorn_threads }} --bind unix:{{ gunicorn_socket }} {{ wsgi_module }}
Environment=PYTHONUNBUFFERED=1
Restart=always
UMask=0007

[Install]
WantedBy=multi-user.target
